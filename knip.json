{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.ts"],
      "project": ["e2e/**/*.ts", "*.{js,cjs,ts}"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "tools/*": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "examples/*": {
      "entry": ["src/backend/app/app.ts", "src/frontend/pages/CheckoutPage.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
