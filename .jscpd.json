{
  "path": ["apps", "packages", "tools", "examples", "e2e"],
  "format": ["typescript", "tsx", "javascript", "css"],
  "threshold": 2,
  "minTokens": 50,
  "minLines": 5,
  "gitignore": true,
  "ignore": ["**/node_modules/**", "**/dist/**", "**/dist-single/**", "**/*.d.ts"],
  "reporters": ["consoleFull"],
  "absolute": true,
  "exitCode": 1
}
