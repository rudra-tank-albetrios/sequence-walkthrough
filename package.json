{
  "name": "sequence-walkthrough",
  "version": "3.0.0-dev",
  "private": true,
  "description": "Turn a Mermaid sequence diagram into a guided, step-by-step walkthrough of how a project really works.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*",
    "tools/*"
  ],
  "scripts": {
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm run check:deps && npm run check:dup && npm run check:unused && npm run check:budgets && npm run check:refs && npm run audit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "check:deps": "depcruise --config .dependency-cruiser.cjs apps packages tools",
    "check:dup": "jscpd",
    "check:unused": "knip",
    "check:budgets": "node tools/check-budgets/src/index.ts",
    "check:refs": "node tools/check-refs/src/index.ts",
    "audit": "npm audit --audit-level=high",
    "smoke": "playwright test --config e2e/smoke.config.ts",
    "dev": "npm run dev -w @swv/web"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
